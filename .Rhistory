library(shiny)
library(leaflet)
library(shinydashboard)
library(shinyWidgets)
library(rvest)
library(readr)
library(leaflet.extras)
library(DT)
# Function for scraping temperature data
scrape_temperature_data <- function() {
url <- "https://en.wikipedia.org/wiki/List_of_countries_by_average_yearly_temperature"
page <- read_html(url)
# Scrape the table containing temperature data
table <- page %>%
html_nodes(".wikitable") %>%
html_table(fill = TRUE) %>%
.[[1]]
# Keep only the necessary columns and rename them
table <- table[, c(1, 2)]
colnames(table) <- c("country", "temperature")
# Clean the temperature column to remove any non-numeric characters
table$temperature <- gsub("[^0-9.]", "", table$temperature)
# Convert the temperature column to numeric
table$temperature <- as.numeric(table$temperature)
# Return the data
table
}
# Test the function
temperature_data <- scrape_temperature_data()
print(temperature_data)
# Function for scraping temperature data
scrape_temperature_data <- function() {
url <- "https://en.wikipedia.org/wiki/List_of_countries_by_average_yearly_temperature"
page <- read_html(url)
# Scrape the table containing temperature data
table <- page %>%
html_nodes(".wikitable") %>%
html_table(fill = TRUE) %>%
.[[1]]
# Keep only the necessary columns and rename them
table <- table[, c(1, 2)]
colnames(table) <- c("country", "temperature")
# Extract only the Celsius values from the temperature column
table$temperature <- gsub(" .*", "", table$temperature)
# Convert the temperature column to numeric
table$temperature <- as.numeric(table$temperature)
# Return the data
table
}
# Test the function
temperature_data <- scrape_temperature_data()
print(temperature_data)
# Function for scraping temperature data
scrape_temperature_data <- function() {
url <- "https://en.wikipedia.org/wiki/List_of_countries_by_average_yearly_temperature"
page <- read_html(url)
# Scrape the table containing temperature data
table <- page %>%
html_nodes(".wikitable") %>%
html_table(fill = TRUE) %>%
.[[1]]
# Keep only the necessary columns and rename them
table <- table[, c(1, 2)]
colnames(table) <- c("country", "temperature")
# Extract only the Celsius values from the temperature column
table$temperature <- gsub(" .*", "", table$temperature)
# Remove any non-numeric characters and convert the temperature column to numeric
table$temperature <- as.numeric(gsub("[^0-9.]", "", table$temperature))
# Return the data
table
}
# Test the function
temperature_data <- scrape_temperature_data()
print(temperature_data)
# Funktion zum Scrapen der Temperaturdaten
scrape_temperature_data <- function() {
url <- "https://en.wikipedia.org/wiki/List_of_countries_by_average_yearly_temperature"
page <- read_html(url)
# Tabelle mit Temperaturdaten scrapen
table <- page %>%
html_nodes(".wikitable") %>%
html_table(fill = TRUE) %>%
.[[1]]
# Nur die notwendigen Spalten behalten und umbenennen
table <- table[, c(1, 2)]
colnames(table) <- c("country", "temperature")
# Temperaturspalte bereinigen, um nur Celsius-Werte zu extrahieren
table$temperature <- gsub(" .*", "", table$temperature)
# Nicht-numerische Zeichen entfernen und die Temperaturspalte in numerisch umwandeln
table$temperature <- as.numeric(gsub("[^0-9.-]", "", table$temperature))
# Nur Länderzeilen behalten (indem wir NA-Werte in der Temperaturspalte entfernen)
table <- table[!is.na(table$temperature),]
# Daten zurückgeben
table
}
# Funktion testen
temperature_data <- scrape_temperature_data()
print(temperature_data)
View(temperature_data)
# Funktion testen
temperature_data <- scrape_temperature_data()
# Funktion testen
temperature_data <- scrape_temperature_data()
print(temperature_data)
# Funktion zum Scrapen der Temperaturdaten
scrape_temperature_data <- function() {
url <- "https://en.wikipedia.org/wiki/List_of_countries_by_average_yearly_temperature"
page <- read_html(url)
# Tabelle mit Temperaturdaten scrapen
table <- page %>%
html_nodes(".wikitable") %>%
html_table(fill = TRUE) %>%
.[[1]]
# Nur die notwendigen Spalten behalten und umbenennen
table <- table[, c("Country", "Temperature\n(°C)")]
colnames(table) <- c("country", "temperature")
# Temperaturspalte bereinigen, um nur Celsius-Werte zu extrahieren
table$temperature <- gsub(" .*", "", table$temperature)
# Nicht-numerische Zeichen entfernen und die Temperaturspalte in numerisch umwandeln
table$temperature <- as.numeric(gsub("[^0-9.-]", "", table$temperature))
# Nur Länderzeilen behalten (indem wir NA-Werte in der Temperaturspalte entfernen)
table <- table[!is.na(table$temperature),]
# Daten zurückgeben
table
}
# Funktion testen
